# ==============================================================
# Mock Exam Platform - Environment Configuration
# ==============================================================

# Database URL
# Default: Portable SQLite database (Zero setup required)
DATABASE_URL=sqlite:///./exam_platform.db

# If you prefer PostgreSQL on hosted providers (e.g. Supabase, Render, Railway):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# If you want to connect MongoDB credentials (optional custom storage):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/exam_platform

# JWT Secret for User Authentication (Change this in production)
JWT_SECRET=production-secret-mock-exam-platform-change-me

# Server Port
PORT=8000
